  "findings": {
    "ecm": "同一ECM从2.087秒经MSL至7.071秒继续活动；27.108秒玩家支援引用已清但对象活动；30.003秒对象退场，冷却继续至32.089/42秒。",
    "tls": "Morgan x1同一对象及SWP1/sp11附着从1.224秒连续至3.181秒；发射即开始10秒冷却，寿命8秒，最后一发结束切换标志开启。",
    "shared_candidate": "保留原生持续对象与源槽登记，隔离非当前源槽结束时操作当前SP的政策；保留原生寿命和效果更新，不重复激活。",
    "current_sp_callback": "0x885240在检查结束对象的最后一发标志之前就读取当前SP的bAutoFireOnHold并可能调用0x8860f0，因此ECM也需要结束归属隔离。",
    "type_corrections": "owner+0x158为嵌套组件数组，SP组+0x48为WeaponParameters；二者均不是已证明的活动Actor对象池。Morgan TLS附着不在该组件清理池。",
    "ecm_world_query": "0x4e3be0筛选类相关集合中的活动效果，0x7fe240调用链按0x86bc00/0x86bc90重算目标干扰/支援；0x86c020随所属飞机更新效果位置。"
  },
  "unverified": [
    "跨另一SP重建后Actor保有/重用与有效登记",
    "敌方锁定/导弹干扰与友方增益的完整实战效果",
    "非当前源槽自然结束是否不干扰当前SP",
    "TLS跨SP根组件/父链/Socket变换及真实伤害",
    "最后一发、快速切回、补给、死亡、重启、检查点、其他TLS/ECM变体"
  ],
  "data_notes": [
    "原始地址、字节、全文只在Temp；本记录保存摘要及哈希。",
    "早期采样字段sp_object_pool已由现场类型纠正为WeaponParameters；不采用该误命名作类型依据。",
    "ecm-active-native早期owner_pool按错误外层步长读取，未用于结论；采用ecm-msl-paused之后的嵌套数组采样。",
    "PE异常展开记录可能只是函数片段；连续range片段也不代表函数边界。",
    "采样工具逐步补充字段，最终版本不是所有早期快照的原始脚本快照。"
  ]
