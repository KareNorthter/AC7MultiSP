      "0x628": "游戏基址+0x895fd0",
      "0x680": "游戏基址+0x86bf90"
    },
    "现有装填校验": "weapon+0x458为1，+0x459为0，+0x5d8为空；未放宽",
    "菜单": "对当前实例三槽实际CDO逐项核对，确认CDO类属于实际配置；新能力标记要求成套核心。",
    "运行": "初始化后的实际默认对象再核资格；换槽前对实际效果对象核回调/装填、玩家归属和发射代次。",
    "效果": "使用原生数组、游戏分配器和原有临时Root窗口保有引用；按真实类型区分电子战/TLS/UAV；不改作者计时、增益、伤害、重放蓝图脚本或伪造弹药槽。",
    "附加效果": "仅处理同玩家原生ActiveWeapons/SpawnedWeapons中的真实电子战；无逻辑来源记为-1供诊断，不向虚构槽写回冷却。",
    "边界": "原有补给/检查点/失败原生收尾保留，调试换装对所有机型检查活动电子战/尾迹。未知机制明确拒绝，不能删除写入安全检查。"
  },
