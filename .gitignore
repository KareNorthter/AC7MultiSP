# 临时产物和备份不进入版本管理。
/Temp/
/backup/
/build*/
__pycache__/
*.pyc
*.pyo
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.log

# 便携工具及 Python 依赖只保留在本机，说明文档进入 Git。
/tools/*
!/tools/README.md

# 保留当前安装包，但不把可再生成的发布产物写进 Git。
/Release/*
!/Release/README.md
!/Release/baseline-0.1.7.json

# 安装载荷中的模组副本由 dist 同步；加载器及许可证单独跟踪。
/payload/ue4ss/Mods/DualSP/bin/
/payload/ue4ss/Mods/DualSP/Scripts/

# 运行时配置、命令及状态不是源码。
/dist/DualSP/profiles*.json
/dist/DualSP/*-command.txt
/dist/DualSP/*-state*.json
/dist/DualSP/catalogue*.json
/dist/DualSP/ui-*.json

# 用户提取的音频仅在本机使用，不提交原始游戏媒体。
/dist/DualSP/Audio/*.wav

# 会话附件的选定参考图已归档到 references，不提交传输目录。
/.codex-remote-attachments/

# 暂停静音恢复记录及原子写入中间文件属于个人运行状态。
/dist/DualSP/management-audio-state.json*
